{
  "language": "en-GB,en-US",
  "ignoreRegExpList": ["vim-api"],
  "patterns": [
    {
      "name": "vim-api",
      "pattern": "vim\\.(api|diagnostic|fn|g|o|opt|hl)\\.\\w+"
    }
