    "kanagawa",
    "keymap",
    "keymaps",
    "killall",
    "lazyvim",
    "lightyellow",
    "linemode",
    "mktemp",
    "mobbin",
    "nvim",
    "opencode",
    "orbstack",
    "pdfinfo",
    "pdftotext",
    "rustup",
    "sainnhe",
    "shellenv",
    "statusline",
    "supabase",
    "superwhisper",
    "symbolichotkeys",
    "tabdo",
    "tokyonight",
