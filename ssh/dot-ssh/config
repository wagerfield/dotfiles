# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host github.com
    HostName github.com
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_ed25519

Host prg.github.com
    HostName github.com
    IdentitiesOnly yes
    IdentityFile ~/.ssh/prg_ed25519

Host make.github.com
    HostName github.com
    IdentitiesOnly yes
    IdentityFile ~/.ssh/make_ed25519
